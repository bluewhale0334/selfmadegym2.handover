rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 현재 사용자의 user_type 확인 함수
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.user_type == "admin";
    }


    match /tagColors/{colorId} {
      allow read: if true;
      // 자신의 uid로 생성하거나, admin이 생성 (isAdmin 체크 시 문서가 없을 수 있으므로 exists 확인)
      allow create: if request.auth != null
        && (request.resource.data.uid == request.auth.uid 
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && isAdmin()));
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      // 자신의 문서 생성 (회원가입)
      // request.auth.uid가 userId와 일치하고, 인증된 사용자여야 함
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // 자신의 문서는 읽기/쓰기 가능
      // 또는 인증된 사용자는 customer 타입 사용자 목록 조회 가능 (인수인계 기능)
      // admin은 모든 사용자 문서 읽기 가능
      allow read: if request.auth != null 
        && (request.auth.uid == userId 
            || resource.data.user_type == "customer" 
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isAdmin()));
      // 자신의 문서는 업데이트 가능
      // admin은 다른 사용자의 user_type, tagColor, email, disabled 필드 변경 가능
      allow update: if request.auth != null 
        && (request.auth.uid == userId 
            || (isAdmin() && (
                // admin이 변경할 수 있는 필드들: user_type, tagColor, email, disabled
                // 이 필드들만 변경하는 경우 (다른 필드는 변경하지 않음) 허용
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_type'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tagColor'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_type', 'tagColor'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_type', 'email'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_type', 'disabled'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tagColor', 'email'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tagColor', 'disabled'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'disabled'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'tagColor', 'disabled'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_type', 'tagColor', 'email'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_type', 'tagColor', 'disabled'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_type', 'email', 'disabled'])
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['user_type', 'tagColor', 'email', 'disabled'])
              )));
    }

    // 공통 함수들
    function canUpdateReadBy(existingData, newData) {
      return request.auth != null
             && newData.diff(existingData).affectedKeys().hasOnly(['readBy'])
             && newData.readBy is list
             && (
               // readBy 필드가 기존에 없었던 경우
               (!(existingData.readBy is list) 
                && newData.readBy.size() == 1
                && newData.readBy[0].userId == request.auth.uid)
               ||
               // readBy 필드가 기존에 있었던 경우
               (existingData.readBy is list 
                && newData.readBy.size() == existingData.readBy.size() + 1
                && newData.readBy[newData.readBy.size() - 1].userId == request.auth.uid)
             );
    }

    function canUpdateComments(existingData, newData) {
      return request.auth != null
             && newData.diff(existingData).affectedKeys().hasOnly(['comments'])
             && newData.comments is list
             && (
               // 댓글 추가: comments 필드가 기존에 없었던 경우
               (!(existingData.comments is list) && newData.comments.size() == 1
                && newData.comments[0].userId == request.auth.uid)
               ||
               // 댓글 추가: comments 필드가 기존에 있었던 경우
               (existingData.comments is list 
                && newData.comments.size() == existingData.comments.size() + 1
                && newData.comments[newData.comments.size() - 1].userId == request.auth.uid)
               ||
               // 댓글 수정: 배열 크기는 같음 (내용만 변경)
               (existingData.comments is list
                && newData.comments.size() == existingData.comments.size())
               ||
               // 댓글 삭제: 배열 크기가 1 감소
               (existingData.comments is list
                && newData.comments.size() == existingData.comments.size() - 1)
             );
    }

    // 전체 공지 - 모든 인증된 사용자가 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 업무 지시 - 모든 인증된 사용자가 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /instructions/{instructionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt', 'date']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 일일 인수인계 - 모든 인증된 사용자가 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /handovers/{handoverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt', 'date']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 업무 진행사항 - 모든 인증된 사용자가 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /progresses/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt', 'date']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 업무 체크리스트 - 사용자별로 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /checklists/{checklistId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin())
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt', 'date', 'userId']));
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin())
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}
