rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 관리자 여부를 확인하는 공통 함수 (경로 최적화)
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null && userDoc != null && userDoc.data.user_type == "admin";
    }

    match /users/{userId} {
      // 생성: 인증된 사용자가 자신의 UID로 문서를 만들 때 허용
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // 읽기: 1.본인 2.이미 생성된 customer 타입 유저 3.관리자
      // resource != null 체크를 통해 문서가 없는 상태에서의 에러 방지
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        (resource != null && resource.data.user_type == "customer") || 
        isAdmin()
      );
      
      // 업데이트 및 삭제
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && isAdmin();
    }

    match /tagColors/{colorId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 공통 함수들
    function canUpdateReadBy(existingData, newData) {
      return request.auth != null
             && newData.diff(existingData).affectedKeys().hasOnly(['readBy'])
             && newData.readBy is list
             && (
               // readBy 필드가 기존에 없었던 경우
               (!(existingData.readBy is list) 
                && newData.readBy.size() == 1
                && newData.readBy[0].userId == request.auth.uid)
               ||
               // readBy 필드가 기존에 있었던 경우
               (existingData.readBy is list 
                && newData.readBy.size() == existingData.readBy.size() + 1
                && newData.readBy[newData.readBy.size() - 1].userId == request.auth.uid)
             );
    }

    function canUpdateComments(existingData, newData) {
      return request.auth != null
             && newData.diff(existingData).affectedKeys().hasOnly(['comments'])
             && newData.comments is list
             && (
               // 댓글 추가: comments 필드가 기존에 없었던 경우
               (!(existingData.comments is list) && newData.comments.size() == 1
                && newData.comments[0].userId == request.auth.uid)
               ||
               // 댓글 추가: comments 필드가 기존에 있었던 경우
               (existingData.comments is list 
                && newData.comments.size() == existingData.comments.size() + 1
                && newData.comments[newData.comments.size() - 1].userId == request.auth.uid)
               ||
               // 댓글 수정: 배열 크기는 같음 (내용만 변경)
               (existingData.comments is list
                && newData.comments.size() == existingData.comments.size())
               ||
               // 댓글 삭제: 배열 크기가 1 감소
               (existingData.comments is list
                && newData.comments.size() == existingData.comments.size() - 1)
             );
    }

    // 전체 공지 - 모든 인증된 사용자가 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 업무 지시 - 모든 인증된 사용자가 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /instructions/{instructionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt', 'date']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 일일 인수인계 - 모든 인증된 사용자가 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /handovers/{handoverId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt', 'date']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 업무 진행사항 - 모든 인증된 사용자가 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /progresses/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt', 'date']));
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 업무 체크리스트 - 사용자별로 읽기/쓰기 가능, 수정/삭제는 작성자만 또는 admin
    match /checklists/{checklistId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin())
        && (resource.data.authorId == request.auth.uid
            || isAdmin()
            || canUpdateReadBy(resource.data, request.resource.data)
            || canUpdateComments(resource.data, request.resource.data)
            || request.resource.data.diff(resource.data).unchangedKeys().hasAll(['content', 'authorId', 'authorName', 'tagColor', 'createdAt', 'date', 'userId']));
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin())
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}