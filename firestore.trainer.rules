rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /applications/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name','gender','phone','email','branch','resumeUrl','createdAt',
        'result','interviewAt','onHold','memo'
      ])
      && request.resource.data.name is string
      && request.resource.data.gender is string
      && request.resource.data.phone is string
      && request.resource.data.email is string
      && request.resource.data.branch is string
      && request.resource.data.resumeUrl is string
      && request.resource.data.createdAt is timestamp
      && (!request.resource.data.keys().hasAny(['result'])
          || request.resource.data.result is string)
      && (!request.resource.data.keys().hasAny(['interviewAt'])
          || request.resource.data.interviewAt is timestamp)
      && (!request.resource.data.keys().hasAny(['onHold'])
          || request.resource.data.onHold is bool)
      && (!request.resource.data.keys().hasAny(['memo'])
          || request.resource.data.memo is string);

      allow read: if true;

      allow update: if request.resource.data.keys().hasOnly([
        'name','gender','phone','email','branch','resumeUrl','createdAt',
        'result','interviewAt','onHold','memo'
      ])
      && request.resource.data.name is string
      && request.resource.data.gender is string
      && request.resource.data.phone is string
      && request.resource.data.email is string
      && request.resource.data.branch is string
      && request.resource.data.resumeUrl is string
      && request.resource.data.createdAt is timestamp
      && (!request.resource.data.keys().hasAny(['result'])
          || request.resource.data.result is string)
      && (!request.resource.data.keys().hasAny(['interviewAt'])
          || request.resource.data.interviewAt is timestamp)
      && (!request.resource.data.keys().hasAny(['onHold'])
          || request.resource.data.onHold is bool)
      && (!request.resource.data.keys().hasAny(['memo'])
          || request.resource.data.memo is string);

      allow delete: if true;
    }
  }
}
